# ESPHome Secrets Template
# Copy this file to secrets.yaml and fill in your actual values
# DO NOT commit secrets.yaml to version control!

# WiFi credentials
wifi_ssid: "Your_WiFi_Network_Name"
wifi_password: "your_wifi_password"

# Fallback AP password (when WiFi fails)
ap_password: "fallback_password_123"

# API encryption key (generate with: openssl rand -base64 32)
api_key: "your_32_character_api_encryption_key=="

# OTA update password
ota_password: "your_ota_update_password"